{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@animeapi/ai-sdk-provider": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "examples"
  ]
}